# Copy to .env and fill in. .env is git-ignored; this file holds names only, never values.

# --- existing ----------------------------------------------------------------
# Production / default connection. Used when NODE_ENV is neither development nor test.
MONGODB_URI=
PORT=3000

# --- local development and tests ---------------------------------------------
# These exist so that developing or running tests can never touch production data.
#
#   NODE_ENV=development -> MONGODB_URI_LOCAL (falls back to MONGODB_URI if unset)
#   NODE_ENV=test        -> MONGODB_URI_TEST  (required; tests refuse to run without it)
#
# MONGODB_URI_TEST must point at a LOCAL mongod. The test helper asserts this and throws
# otherwise, because the suite calls dropDatabase() and pointing that at Atlas would
# destroy real data. mongodb+srv:// URIs are rejected outright.
# Each test run creates its own uniquely-named database on that server and drops it after.
MONGODB_URI_LOCAL=
MONGODB_URI_TEST=

# Mongoose builds indexes on every process start when this is true. Leave it FALSE in
# production: with it on, declaring an index on an existing schema issues createIndex
# against the live collection on the next deploy. Use scripts/ensureIndexes.js instead.
# true is fine (and convenient) locally and in tests.
MONGO_AUTO_INDEX=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

YOUTUBE_API_KEY=

# --- token authentication (/api/v2/auth) -------------------------------------
# Secret for signing access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates every access token immediately (refresh tokens survive, since
# they are random values in the database rather than signed JWTs).
JWT_ACCESS_SECRET=

# Access-token lifetime. Short on purpose: an access token is stateless and therefore
# cannot be revoked, so its blast radius is bounded by this value alone.
JWT_ACCESS_TTL=15m

# Refresh-token lifetime. These ARE revocable — rotated on every use, with reuse
# detection that revokes the whole family.
REFRESH_TOKEN_TTL_DAYS=30

# Accepting a `channelId` in the request body as proof of identity. This now defaults
# to OFF: the existing writes require a real token, which is what closed the hole where
# anyone could act as anyone by naming their channel.
#
# Set it to true ONLY as a rollback, if a client that cannot send tokens turns out to
# still be in use. It is deliberately a variable rather than a code change, because
# this is the one setting that can lock every user out. Responses on the fallback path
# carry Deprecation and Sunset headers so the legacy traffic is visible in logs.
LEGACY_ACTOR_FALLBACK=false


# --- new, required only by POST /api/v2/upload -------------------------------
# Without these the moderated route fails every upload (and deletes the asset),
# because an unmoderated video is never accepted. POST /video/upload is unaffected.

# Base URL of the transcript/frames service, no trailing slash.
# The route appends /v1/frames and /v1/translate.
TRANSCRIPT_SERVICE_URL=

# The shared secret that service expects in its x-api-key header.
TRANSCRIPT_SERVICE_API_KEY=

# Base URL of the text moderation service; the route appends /moderate.
TEXT_MODERATION_URL=

# Base URL of the image moderation service; the route appends /moderate-images.
IMAGE_MODERATION_URL=


# --- frame moderation tuning --------------------------------------------------
# How a video's sampled frames add up to one verdict. Leave these unset unless you have
# re-measured the classifier; the defaults come from moderation-eval's 673-image labelled
# set (results/metrics.json, violence axis).
#
# The image service's own `safe` flag sits at roughly a 0.3 threshold, where the measured
# per-frame false-positive rate is 0.181. Rejecting on one flagged frame out of 30 would
# therefore reject 1 - 0.819^30 = 99.75% of clean videos - and did: a news interview and a
# generated colour-bar test pattern were both rejected. So the score is re-thresholded
# here, and a FRACTION of frames must clear it.
#
# Violence score, from the threshold sweep:
# On the 673-image labelled set, counting actual images rather than rates:
#
#   thr    violent caught    safe wrongly rejected
#   0.3     10 of 20          130 of 699  (18.6%)   <- the service's own flag
#   0.5      8 of 20           61 of 699   (8.7%)
#   0.7      1 of 20           20 of 699   (2.9%)   <- the default
#   0.8      0 of 20            9 of 699   (1.3%)
#
# At EVERY threshold it rejects more safe images than it catches violent ones, because the
# score does not separate them: the worst violent image scores 0.752, the worst safe image
# scores 0.956, and 17 safe images score above the worst violent one. 10 of the 20 violent
# images score exactly 0.000. There is no setting that passes safe content and catches
# violence - 0.7 chooses "do not reject safe content", which makes the visual check close
# to off. Safety rests on the text and transcript stages until the model is replaced.
#
# Lower IMAGE_VIOLENCE_THRESHOLD or FRAME_FLAG_RATIO to catch more and reject more of what
# is fine; raise them for the opposite. Note the ceiling on what either can buy you:
# violence ROC AUC is 0.669 and 10 of 20 true positives score exactly 0.000, so no setting
# makes this stage a guarantee.
#
# IMAGE_VIOLENCE_THRESHOLD=0.7    # the bar for EVERY image: video frames, the video
#                                 # thumbnail, and community post images
# FRAME_FLAG_RATIO=0.4            # fraction of checked frames that must be flagged
# FRAME_MIN_FLAGGED=3             # floor under the ratio, so a SHORT video cannot be
#                                 # rejected by a small group. At 0.081 FPR a floor of 2
#                                 # would reject 5.6% of clean 5-frame clips; 3 makes it
#                                 # 0.5%. In practice the sampler's f_min is 8, so the
#                                 # ratio already demands 4+ - this is the backstop.
#
# IMAGE_NSFW_THRESHOLD=0.5        # the nsfw bar. Weak axis (AUC 0.449) but kept: in the
#                                 # labelled set nothing scores above 0.1 on it, so a 0.5
#                                 # bar rejects nothing while still catching a confident
#                                 # verdict. Dropping it would unblock NSFW everywhere.
#
# The thresholds apply to VIDEO FRAMES only. A thumbnail and a community post image are single
# images: there is no group to take, so each is decided on its one verdict.


# --- rate limiting ------------------------------------------------------------
# Community writes per IP per 10 minutes. The production default is 30, which is a
# sensible ceiling for a person and far too low for an end-to-end walkthrough: over
# `adb reverse` every request arrives from one address, so a run through join → post →
# comment → vote hits the limit partway and starts returning 429s that read as broken
# permissions rather than throttling.
#
# Read ONCE at module load, so changing it needs a restart.
# In NODE_ENV=development this defaults to 100000 even when unset.
COMMUNITY_WRITE_LIMIT=

# --- local development --------------------------------------------------------
# NODE_ENV is not just a label here - it chooses the database (see config/db.js):
#
#   development  -> MONGODB_URI_LOCAL, falling back to MONGODB_URI
#   test         -> MONGODB_URI_TEST, which must be a local mongod
#   anything else, INCLUDING UNSET -> MONGODB_URI
#
# So running locally without NODE_ENV=development reads and writes PRODUCTION. `npm run
# dev` sets it for you; a bare `node index.js` does not.
NODE_ENV=development

# To run the whole stack on this machine, the values below are the usual ones. Each is
# also applied automatically when NODE_ENV=development and the variable is unset, with
# a line in the log saying so - these are here so the choice is visible.
#
#   MONGODB_URI_LOCAL=mongodb://localhost:27017/yteens_dev
#   TRANSCRIPT_SERVICE_URL=http://localhost:8000     # docker compose up, in transcript-and-frames
#   TRANSCRIPT_SERVICE_API_KEY=<must match API_KEY in that service's own .env>
#
# The two moderation services get NO automatic default, because there is no right guess:
# either your deployed Spaces, or the local stub (`npm run stub:moderation`):
#
#   TEXT_MODERATION_URL=http://localhost:8787
#   IMAGE_MODERATION_URL=http://localhost:8787
#
# Check it all with `npm run preflight -- --ping`, and `npm run netcheck` when the phone
# cannot reach this machine.
#
# Script-only knobs, not service configuration:
#   SLOW_MS   how long `npm run stub:moderation` sleeps for a "SLOW" request (default 45000)

# --- transcript (spoken content) tuning ---------------------------------------
# NOT backed by a labelled evaluation - moderation-eval covers the image axes only. These
# are a stated policy, to be calibrated when text labels exist.
#
# A transcript is ASR output from minutes of speech, chunked and scored without context, so
# one chunk is weak evidence. A 9-minute video was rejected on a single chunk reading 0.69
# for toxicity. General labels therefore need a fraction of chunks; the severe ones
# (severe_toxicity, threat, identity_attack) still reject on their own chunk.
#
# TEXT_TOXICITY_THRESHOLD=0.7     # toxicity / insult / obscene
# TEXT_SEVERE_THRESHOLD=0.5       # severe_toxicity / threat / identity_attack
# TRANSCRIPT_FLAG_RATIO=0.4       # fraction of chunks needed for the general labels
# TRANSCRIPT_MIN_FLAGGED=2        # floor, so a short transcript is not judged on one chunk
#
# Short text (community posts and comments) is usually ONE chunk, so it is judged on that
# chunk alone - the same reasoning as a single thumbnail.
